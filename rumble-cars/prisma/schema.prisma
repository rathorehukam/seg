// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
  HOST
}

enum OwnerRole {
  FLEET
  HOST
}

enum VehicleType {
  SCOOTER
  BIKE
  CAR
  SUV
}

enum VehicleStatus {
  AVAILABLE
  BOOKED
  IN_SERVICE
  BLOCKED
}

enum DeviceType {
  BLE
  OBD
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
}

enum CommandType {
  LOCK
  UNLOCK
  IMMOBILIZE
  HORN
  FLASH
}

enum CommandStatus {
  QUEUED
  SENT
  ACK
  FAILED
}

enum BlockReason {
  SERVICE
  ACCIDENT
  MANUAL
}

enum PricingScopeType {
  GLOBAL
  VEHICLE_TYPE
  VEHICLE
  CITY
}

enum PricingRuleType {
  WEEKEND
  HOLIDAY
  SEASON
  DEMAND
}

enum CouponType {
  PCT
  FLAT
}

enum FuelPolicy {
  FULL_TO_FULL
  AS_IS
}

enum BookingStatus {
  HOLD
  CONFIRMED
  IN_USE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum FuelLevel {
  E
  F
  QUARTER
  HALF
  THREE_QUARTER
}

enum TelematicsEventType {
  NORMAL
  HARSH_BRAKE
  OVERSPEED
  GEOFENCE
  IDLE
}

enum FastagStatus {
  ACTIVE
  SUSPENDED
}

enum TrafficFineStatus {
  PENDING
  PAID
  DISPUTED
}

enum IdDocType {
  AADHAAR
  PASSPORT
  OTHER
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WalletTxnType {
  CREDIT
  DEBIT
  REFUND
}

enum ReferralStatus {
  CREATED
  COMPLETED
  EXPIRED
}

enum ValetJobType {
  DELIVERY
  PICKUP
}

enum ValetJobStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum RsaCaseType {
  BREAKDOWN
  ACCIDENT
  OTHER
}

enum RsaCaseStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum FraudAction {
  ALLOW
  REVIEW
  DENY
}

enum PaymentGatewayStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum RefundStatus {
  CREATED
  PROCESSED
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  phone           String   @unique
  name            String
  role            UserRole @default(CUSTOMER)
  isActive        Boolean  @default(true)
  profilePicture  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  vehicles        Vehicle[]
  bookings        Booking[]
  kyc             KYC?
  wallet          Wallet?
  loyaltyLedger   LoyaltyLedger[]
  referralsGiven  Referral[] @relation("ReferrerReferrals")
  referralsReceived Referral[] @relation("RefereeReferrals")
  subscriptions   Subscription[]
  reviews         Review[]
  fraudFlags      FraudFlag[]
  sosEvents       SOSEvent[]
  auditLogs       AuditLog[]
  deviceCommands  DeviceCommand[]
  handoverSigns   HandoverCheck[] @relation("StaffHandover")
  returnChecks    ReturnCheck[] @relation("StaffReturn")
  kycVerifications KYC[] @relation("KycVerifier")

  @@map("users")
}

model Location {
  id         String  @id @default(cuid())
  name       String
  address    String
  lat        Float
  lng        Float
  
  // Relations
  vehiclePickups Vehicle[] @relation("VehiclePickup")
  vehicleDrops   Vehicle[] @relation("VehicleDrop")
  bookingPickups Booking[] @relation("BookingPickup")
  bookingDrops   Booking[] @relation("BookingDrop")

  @@map("locations")
}

model Vehicle {
  id                String        @id @default(cuid())
  ownerRole         OwnerRole
  hostId            String?
  plateNo           String        @unique
  make              String
  model             String
  year              Int
  type              VehicleType
  color             String
  seats             Int
  rcNo              String
  insuranceNo       String
  insuranceExpiry   DateTime
  pucExpiry         DateTime
  fuelPolicy        FuelPolicy
  kmLimitDay        Int
  baseDailyRate     Int
  baseHourlyRate    Int
  deposit           Int
  photos            String[]
  status            VehicleStatus @default(AVAILABLE)
  pickupLocId       String
  dropLocId         String
  description       String?
  features          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  host              User?         @relation(fields: [hostId], references: [id])
  pickupLoc         Location      @relation("VehiclePickup", fields: [pickupLocId], references: [id])
  dropLoc           Location      @relation("VehicleDrop", fields: [dropLocId], references: [id])
  devices           VehicleDevice[]
  calendarBlocks    VehicleCalendarBlock[]
  bookings          Booking[]
  reviews           Review[]
  deviceCommands    DeviceCommand[]
  trips             Trip[]
  telematicsEvents  TelematicsEvent[]
  fastagAccounts    FASTagAccount[]
  trafficFines      TrafficFine[]

  @@map("vehicles")
}

model VehicleDevice {
  id          String       @id @default(cuid())
  vehicleId   String
  type        DeviceType
  imei        String
  serial      String
  status      DeviceStatus
  batteryPct  Int?
  signal      Int?
  lastSeenAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id])

  @@map("vehicle_devices")
}

model DeviceCommand {
  id            String        @id @default(cuid())
  vehicleId     String
  cmd           CommandType
  requestedById String
  status        CommandStatus @default(QUEUED)
  resp          String?
  ts            DateTime      @default(now())

  // Relations
  vehicle       Vehicle       @relation(fields: [vehicleId], references: [id])
  requestedBy   User          @relation(fields: [requestedById], references: [id])

  @@map("device_commands")
}

model VehicleCalendarBlock {
  id        String      @id @default(cuid())
  vehicleId String
  startTs   DateTime
  endTs     DateTime
  reason    BlockReason
  notes     String?
  createdAt DateTime    @default(now())

  // Relations
  vehicle   Vehicle     @relation(fields: [vehicleId], references: [id])

  @@map("vehicle_calendar_blocks")
}

model PricingRule {
  id         String             @id @default(cuid())
  scope      PricingScopeType
  scopeRef   String
  ruleType   PricingRuleType
  pattern    String
  multiplier Float
  delta      Int
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@map("pricing_rules")
}

model Coupon {
  id         String   @id @default(cuid())
  code       String   @unique
  type       CouponType
  value      Int
  maxUses    Int
  validFrom  DateTime
  validTo    DateTime
  terms      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("coupons")
}

model Plan {
  id              String      @id @default(cuid())
  name            String
  durationDays    Int
  price           Int
  vehicleType     VehicleType
  freeKmPerDay    Int
  depositPolicy   Json
  benefits        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  subscriptions   Subscription[]

  @@map("plans")
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  planId    String
  startDate DateTime
  endDate   DateTime
  status    SubscriptionStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  // Relations
  user      User               @relation(fields: [userId], references: [id])
  plan      Plan               @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model Booking {
  id              String        @id @default(cuid())
  bookingNo       String        @unique
  userId          String
  vehicleId       String
  startTs         DateTime
  endTs           DateTime
  pickupLocId     String
  dropLocId       String
  status          BookingStatus @default(HOLD)
  priceBreakdown  Json
  depositAmount   Int
  paymentStatus   PaymentStatus @default(UNPAID)
  isSelfPickup    Boolean       @default(true)
  valetRequired   Boolean       @default(false)
  notes           String?
  legalPdfUrl     String?
  legalVersion    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  user            User          @relation(fields: [userId], references: [id])
  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id])
  pickupLoc       Location      @relation("BookingPickup", fields: [pickupLocId], references: [id])
  dropLoc         Location      @relation("BookingDrop", fields: [dropLocId], references: [id])
  addons          BookingAddon[]
  handoverCheck   HandoverCheck?
  returnCheck     ReturnCheck?
  trips           Trip[]
  trafficFines    TrafficFine[]
  reviews         Review[]
  valetJobs       ValetJob[]
  rsaCases        RSACase[]
  sosEvents       SOSEvent[]
  fraudFlags      FraudFlag[]
  payments        Payment[]

  @@map("bookings")
}

model BookingAddon {
  id         String  @id @default(cuid())
  bookingId  String
  addonCode  String
  name       String
  qty        Int
  unitPrice  Int

  // Relations
  booking    Booking @relation(fields: [bookingId], references: [id])

  @@map("booking_addons")
}

model HandoverCheck {
  id                String    @id @default(cuid())
  bookingId         String    @unique
  odometerOut       Int
  fuelOut           FuelLevel
  exteriorPhotos    String[]
  notes             String?
  signedByUserAt    DateTime?
  signedByStaffAt   DateTime?
  signedByStaffId   String?
  keyless           Boolean   @default(false)
  createdAt         DateTime  @default(now())

  // Relations
  booking           Booking   @relation(fields: [bookingId], references: [id])
  signedByStaff     User?     @relation("StaffHandover", fields: [signedByStaffId], references: [id])

  @@map("handover_checks")
}

model ReturnCheck {
  id                String    @id @default(cuid())
  bookingId         String    @unique
  odometerIn        Int
  fuelIn            FuelLevel
  exteriorPhotos    String[]
  newDamageNotes    String?
  extraKm           Int       @default(0)
  extraFuelCharge   Int       @default(0)
  damageCharge      Int       @default(0)
  lateFee           Int       @default(0)
  cleaningFee       Int       @default(0)
  finalizedAt       DateTime?
  finalizedById     String?
  createdAt         DateTime  @default(now())

  // Relations
  booking           Booking   @relation(fields: [bookingId], references: [id])
  finalizedBy       User?     @relation("StaffReturn", fields: [finalizedById], references: [id])

  @@map("return_checks")
}

model Trip {
  id           String   @id @default(cuid())
  bookingId    String
  vehicleId    String
  startedAt    DateTime
  endedAt      DateTime?
  startGeo     String   // JSON string for lat/lng
  endGeo       String?  // JSON string for lat/lng
  distanceKm   Float?
  avgSpeed     Float?
  maxSpeed     Float?
  violations   Json?
  createdAt    DateTime @default(now())

  // Relations
  booking      Booking  @relation(fields: [bookingId], references: [id])
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
  telematicsEvents TelematicsEvent[]
  tollCharges  TollCharge[]

  @@map("trips")
}

model TelematicsEvent {
  id        String               @id @default(cuid())
  vehicleId String
  tripId    String?
  ts        DateTime
  lat       Float
  lng       Float
  speed     Float
  event     TelematicsEventType
  metaJson  Json?

  // Relations
  vehicle   Vehicle              @relation(fields: [vehicleId], references: [id])
  trip      Trip?                @relation(fields: [tripId], references: [id])

  @@map("telematics_events")
}

model FASTagAccount {
  id         String       @id @default(cuid())
  vehicleId  String
  tagId      String
  provider   String
  balance    Int
  status     FastagStatus
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  // Relations
  vehicle    Vehicle      @relation(fields: [vehicleId], references: [id])
  tollCharges TollCharge[]

  @@map("fastag_accounts")
}

model TollCharge {
  id        String        @id @default(cuid())
  tripId    String
  fastagId  String
  plaza     String
  ts        DateTime
  amount    Int
  refNo     String

  // Relations
  trip      Trip          @relation(fields: [tripId], references: [id])
  fastag    FASTagAccount @relation(fields: [fastagId], references: [id])

  @@map("toll_charges")
}

model TrafficFine {
  id         String            @id @default(cuid())
  bookingId  String?
  vehicleId  String
  challanNo  String
  authority  String
  ts         DateTime
  amount     Int
  status     TrafficFineStatus
  doc        String?
  createdAt  DateTime          @default(now())

  // Relations
  booking    Booking?          @relation(fields: [bookingId], references: [id])
  vehicle    Vehicle           @relation(fields: [vehicleId], references: [id])

  @@map("traffic_fines")
}

model KYC {
  id              String    @id @default(cuid())
  userId          String    @unique
  dlNumber        String
  dlExpiry        DateTime
  idDocType       IdDocType
  idDocNo         String
  dlFront         String
  dlBack          String
  idDoc           String
  selfie          String
  livenessScore   Float?
  duplicateDlFlag Boolean?
  riskScore       Int?
  status          KycStatus @default(PENDING)
  verifiedById    String?
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user            User      @relation(fields: [userId], references: [id])
  verifiedBy      User?     @relation("KycVerifier", fields: [verifiedById], references: [id])

  @@map("kyc")
}

model Wallet {
  id        String       @id @default(cuid())
  userId    String       @unique
  balance   Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  user      User         @relation(fields: [userId], references: [id])
  txns      WalletTxn[]

  @@map("wallets")
}

model WalletTxn {
  id       String        @id @default(cuid())
  walletId String
  type     WalletTxnType
  amount   Int
  reason   String
  ref      String
  ts       DateTime      @default(now())

  // Relations
  wallet   Wallet        @relation(fields: [walletId], references: [id])

  @@map("wallet_txns")
}

model LoyaltyTier {
  id        String @id @default(cuid())
  name      String
  minPoints Int
  perks     Json?

  @@map("loyalty_tiers")
}

model LoyaltyLedger {
  id     String   @id @default(cuid())
  userId String
  points Int
  reason String
  ref    String
  ts     DateTime @default(now())

  // Relations
  user   User     @relation(fields: [userId], references: [id])

  @@map("loyalty_ledger")
}

model Referral {
  id           String         @id @default(cuid())
  referrerId   String
  refereeId    String?
  code         String         @unique
  status       ReferralStatus @default(CREATED)
  rewardPoints Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Relations
  referrer     User           @relation("ReferrerReferrals", fields: [referrerId], references: [id])
  referee      User?          @relation("RefereeReferrals", fields: [refereeId], references: [id])

  @@map("referrals")
}

model ValetJob {
  id        String          @id @default(cuid())
  bookingId String
  type      ValetJobType
  slotTs    DateTime
  address   String
  status    ValetJobStatus  @default(SCHEDULED)
  fee       Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Relations
  booking   Booking         @relation(fields: [bookingId], references: [id])

  @@map("valet_jobs")
}

model RSACase {
  id        String        @id @default(cuid())
  bookingId String
  openedAt  DateTime      @default(now())
  closedAt  DateTime?
  type      RsaCaseType
  provider  String
  status    RsaCaseStatus @default(OPEN)
  notes     String?

  // Relations
  booking   Booking       @relation(fields: [bookingId], references: [id])

  @@map("rsa_cases")
}

model SOSEvent {
  id         String    @id @default(cuid())
  userId     String
  bookingId  String?
  lat        Float
  lng        Float
  ts         DateTime  @default(now())
  resolvedAt DateTime?
  notes      String?

  // Relations
  user       User      @relation(fields: [userId], references: [id])
  booking    Booking?  @relation(fields: [bookingId], references: [id])

  @@map("sos_events")
}

model Review {
  id        String   @id @default(cuid())
  bookingId String
  vehicleId String
  userId    String
  rating    Int
  comment   String?
  tags      Json?
  createdAt DateTime @default(now())

  // Relations
  booking   Booking  @relation(fields: [bookingId], references: [id])
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@map("reviews")
}

model FraudFlag {
  id        String      @id @default(cuid())
  userId    String?
  bookingId String?
  score     Int
  reasons   Json
  action    FraudAction
  ts        DateTime    @default(now())

  // Relations
  user      User?       @relation(fields: [userId], references: [id])
  booking   Booking?    @relation(fields: [bookingId], references: [id])

  @@map("fraud_flags")
}

model Payment {
  id         String                @id @default(cuid())
  bookingId  String
  gateway    String
  orderId    String
  paymentId  String?
  amount     Int
  currency   String                @default("INR")
  status     PaymentGatewayStatus  @default(CREATED)
  eventJson  Json?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  // Relations
  booking    Booking               @relation(fields: [bookingId], references: [id])
  refunds    Refund[]

  @@map("payments")
}

model Refund {
  id        String       @id @default(cuid())
  paymentId String
  amount    Int
  reason    String
  status    RefundStatus @default(CREATED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  payment   Payment      @relation(fields: [paymentId], references: [id])

  @@map("refunds")
}

model AuditLog {
  id       String   @id @default(cuid())
  actorId  String
  action   String
  entity   String
  entityId String
  metaJson Json?
  ts       DateTime @default(now())

  // Relations
  actor    User     @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}
